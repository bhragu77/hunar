# Copy to .env.local for native (non-Docker) development.
NEXT_PUBLIC_API_URL=http://localhost:8010

# --- Auth (Google OAuth + guest mode) ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-with-a-random-secret
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized JavaScript origin: http://localhost:3010
# Authorized redirect URI:      http://localhost:3010/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3010

# Shared with the backend's INTERNAL_API_TOKEN - see app/api/voice-provider/route.ts.
INTERNAL_API_TOKEN=dev-internal-token-change-me
