# --- Backend ---
HUNAR_API_KEY=replace-me
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
VOICE_PROVIDER=mock                 # mock | hunar
DATABASE_URL=postgresql://hunar:hunar@localhost:5442/hunar
BACKEND_CORS_ORIGINS=http://localhost:3010

# This backend's own URL, for MockProvider to POST its self-signed webhook to. For a native
# run this is the same host/port you start uvicorn on (localhost:8010 by default). Inside
# docker-compose this is overridden to http://localhost:8000 - the container-internal port -
# see docker-compose.yml.
INTERNAL_BASE_URL=http://localhost:8010

PUBLIC_BASE_URL=                    # public https base for real Hunar webhooks (ngrok/deploy)
MOCK_WEBHOOK_SECRET=dev-mock-secret # dev placeholder; MockProvider signs its own webhooks with this
MOCK_CALL_DURATION_SECONDS=8        # how long a simulated call takes to reach COMPLETED
POLL_INTERVAL_SECONDS=10            # polling reconciler cadence
POLL_STALE_AFTER_SECONDS=20         # only poll non-terminal calls whose last update is older than this
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Post-call pipeline (transcript + AI scorecard) - see app/services/post_call.py. Mock
# backends make zero network calls, so the Hiring Assistant module demos end-to-end with no
# external keys at all. Real providers upgrade each layer independently, no code changes.
LLM_PROVIDER=mock                   # mock | anthropic | openai
LLM_MODEL=                          # optional model override
TRANSCRIPTION_PROVIDER=mock         # mock | openai | disabled
ENABLE_POST_CALL_PIPELINE=true

# People Search & Reachout (Module 2) - see app/integrations/people_search/. "mock" makes
# zero network calls, so the whole module demos end-to-end with no external keys.
PEOPLE_SEARCH_PROVIDER=mock         # mock | apollo | pdl
PEOPLE_SEARCH_MAX_RESULTS=25
AGENT_AUTOCREATE=true               # auto-create the outreach voice agent from the JD via the provider

# Attendance (Module 3) - see app/services/attendance.py. Supervisor roll-call + missed-call
# inbound both run on "mock" with zero network calls, so the whole module demos at
# 1,000-worker/100-location scale with no external keys.
ATTENDANCE_PRESENT_RATE=0.85         # mock roll-call target present ratio (demo realism)
ATTENDANCE_MISSED_CALL_RATE=0.4      # fraction auto-marked when simulating the missed-call window
DEMO_SEED_ON_START=false             # seed the Attendance demo dataset on boot if empty (see render.yaml) - off locally on purpose

APOLLO_API_KEY=
PDL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8010

# --- docker-compose host port overrides ---
# Defaults below are deliberately non-standard (8010/3010/5442) because this
# dev machine already has other projects bound to 8000/3000/5432. On a clean
# machine you can safely override these back to 8000/3000/5432.
BACKEND_PORT=8010
FRONTEND_PORT=3010
POSTGRES_PORT=5442
