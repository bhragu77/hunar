# Deepgram: used for BOTH streaming STT and Aura TTS - one key covers both.
# Free key with trial credit: https://console.deepgram.com
DEEPGRAM_API_KEY=replace-me

# Groq: OpenAI-compatible API serving open-source models (Llama 3.3 70B) at very low latency.
# Free key: https://console.groq.com
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile

# The public HTTPS URL this server is reachable on - Twilio needs to reach it to open the
# call's Media Stream. While developing locally this is your ngrok URL, e.g.
# https://abcd1234.ngrok-free.app (no trailing slash). Must be updated every time ngrok
# restarts with a free account (the URL changes).
PUBLIC_BASE_URL=https://replace-me.ngrok-free.app

# Deepgram STT/TTS tuning - defaults are fine to start.
DEEPGRAM_TTS_MODEL=aura-asteria-en
# How many ms of silence before Deepgram decides the caller's turn is over (speech_final).
# Lower = snappier but more likely to cut someone off mid-sentence; higher = safer but adds
# dead-air latency before the bot replies.
DEEPGRAM_STT_ENDPOINTING_MS=300
